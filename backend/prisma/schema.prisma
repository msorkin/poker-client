generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  WAITING     // Players joining
  ACTIVE      // Game started but between hands
  IN_PROGRESS // Hand in progress
  CLOSED      // Table closed by admin
}

enum BettingRound {
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     TableSession[]
}

model Game {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  closedAt      DateTime?
  status        GameStatus
  smallBlind    Int
  bigBlind      Int
  maxHands      Int
  currentHand   Int      @default(0)
  dealerIndex   Int      @default(0)
  currentRound  BettingRound?
  hands         Hand[]
  sessions      TableSession[]
}

model Hand {
  id              String   @id @default(uuid())
  game            Game     @relation(fields: [gameId], references: [id])
  gameId          String
  handNumber      Int
  communityCards  String   // JSON array of cards
  pot             Int
  sidePots        String   // JSON array of side pots
  currentBet      Int
  dealerIndex     Int
  isShowdown      Boolean  @default(false)
  playerStates    String   // JSON array of player states
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model TableSession {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  player    User     @relation(fields: [playerId], references: [id])
  playerId  String
  joinedAt  DateTime @default(now())
  stack     Int      // Current chip stack
  seatIndex Int      // Position at table
}

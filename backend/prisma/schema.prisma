// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  WAITING     // Players joining
  ACTIVE      // Game started but between hands
  IN_PROGRESS // Hand in progress
  CLOSED      // Table closed by admin
}

enum BettingRound {
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
}

enum TransactionType {
  BUYIN
  CASHOUT
  REBUY
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  balance      Int      @default(0)
  createdAt    DateTime @default(now())
  sessions     TableSession[]
  transactions Transaction[]
}

model Game {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  closedAt      DateTime?
  status        GameStatus
  smallBlind    Int
  bigBlind      Int
  minBuyIn      Int      @default(100)  // Default to 100 chips
  maxBuyIn      Int      @default(1000) // Default to 1000 chips
  maxHands      Int
  maxSeats      Int      @db.SmallInt   // Maximum number of players allowed at the table
  currentHand   Int      @default(0)
  dealerIndex   Int      @default(0)
  currentRound  BettingRound?
  hands         Hand[]
  sessions      TableSession[]
  transactions  Transaction[]

  @@check(maxSeats >= 2 && maxSeats <= 9)
}

model Hand {
  id              String   @id @default(uuid())
  game            Game     @relation(fields: [gameId], references: [id])
  gameId          String
  handNumber      Int
  communityCards  String   // JSON array of cards
  pot             Int
  sidePots        String   // JSON array of side pots
  currentBet      Int
  dealerIndex     Int
  isShowdown      Boolean  @default(false)
  playerStates    String   // JSON array of player states
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model TableSession {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  player    User     @relation(fields: [playerId], references: [id])
  playerId  String
  joinedAt  DateTime @default(now())
  stack     Int      // Current chip stack
  seatIndex Int      // Position at table

  @@unique([gameId, seatIndex])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          TransactionType
  amount        Int
  gameId        String?
  game          Game?           @relation(fields: [gameId], references: [id])
  balanceBefore Int
  balanceAfter  Int
  timestamp     DateTime        @default(now())
  status        String          @default("COMPLETED")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  WAITING
  ACTIVE
  IN_PROGRESS
  CLOSED
}

enum BettingRound {
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
}

enum TransactionType {
  BUYIN
  CASHOUT
  REBUY
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  balance      Int            @default(0)
  createdAt    DateTime       @default(now())
  sessions     TableSession[]
  transactions TransactionRecord[]
}
    
model Game {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  closedAt      DateTime?
  status        GameStatus
  smallBlind    Int
  bigBlind      Int
  minBuyIn      Int            @default(100)
  maxBuyIn      Int            @default(1000)
  maxHands      Int
  maxSeats      Int            @db.SmallInt
  currentHand   Int            @default(0)
  dealerIndex   Int            @default(0)
  currentRound  BettingRound?
  hands         Hand[]
  sessions      TableSession[]
  transactions  TransactionRecord[]
}

model Hand {
  id             String   @id @default(uuid())
  game           Game     @relation(fields: [gameId], references: [id])
  gameId         String
  handNumber     Int
  communityCards String   // JSON array of cards
  pot            Int
  sidePots       String   // JSON array of side pots
  currentBet     Int
  dealerIndex    Int
  sbIndex        Int
  bbIndex        Int
  isShowdown     Boolean  @default(false)
  playerStates   String   // JSON array of player states
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  state BettingRound @default(PREFLOP)
}

model TableSession {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  player    User     @relation(fields: [playerId], references: [id])
  playerId  String
  joinedAt  DateTime @default(now())
  stack     Int
  seatIndex Int

  @@unique([gameId, seatIndex])
  @@unique([gameId, playerId])
}

model TransactionRecord {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          TransactionType
  amount        Int
  gameId        String?
  game          Game?           @relation(fields: [gameId], references: [id])
  balanceBefore Int
  balanceAfter  Int
  timestamp     DateTime        @default(now())
  status        String          @default("COMPLETED")
}
